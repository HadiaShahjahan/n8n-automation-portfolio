    {
      "parameters": {
        "jsCode": "const lead = $('Normalize and Validate').first().json.lead;\nlet parsed = null;\nlet source = 'rules_fallback';\ntry {\n  const content = $json?.choices?.[0]?.message?.content;\n  if (typeof content === 'string') parsed = JSON.parse(content);\n} catch (error) {\n  parsed = null;\n}\nlet score;\nlet reason;\nif (parsed && Number.isFinite(Number(parsed.score))) {\n  score = Math.max(0, Math.min(100, Math.round(Number(parsed.score))));\n  reason = String(parsed.reason ?? 'AI qualification completed').slice(0, 280);\n  source = 'openai';\n} else {\n  score = 20;\n  const size = String(lead.company_size).toLowerCase();\n  if (/51-200|201-500|501-1000|1000\\+/.test(size)) score += 25;\n  if (/manager|director|head|vp|vice president|chief|owner|founder/i.test(lead.job_title)) score += 25;\n  if (lead.company_domain) score += 10;\n  if (lead.message.length >= 40) score += 15;\n  score = Math.min(100, score);\n  reason = 'Deterministic fallback based on supplied company size, role, domain, and message completeness.';\n}\nreturn [{ json: { lead, score, qualification_reason: reason, qualification_source: source } }];"
      },
