        "body": "={{ JSON.stringify({ model: $env.OPENAI_MODEL || 'gpt-4.1-mini', response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Classify an inbound B2B sales lead. Return JSON only with integer score from 0 to 100 and a concise reason. Do not infer sensitive personal traits.' }, { role: 'user', content: JSON.stringify($('Normalize and Validate').first().json.lead) } ] }) }}",
