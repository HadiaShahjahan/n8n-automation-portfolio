        "jsCode": "const base = $('Parse AI Qualification').first().json;\nconst route = base.score >= 80 ? 'HOT' : base.score >= 50 ? 'WARM' : 'COLD';\nconst eligible = base.lead.consent === true && route !== 'COLD';\nreturn [{ json: { request_id: base.lead.request_id, email: base.lead.email, first_name: base.lead.first_name, company: base.lead.company, score: base.score, route, qualification_reason: base.qualification_reason, qualification_source: base.qualification_source, consent: base.lead.consent, should_send_initial_email: eligible, should_follow_up: eligible } }];"
      },
