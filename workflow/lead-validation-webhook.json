      "parameters": {
        "content": "## Safe lead intake boundary\n\nThis reusable template normalizes a JSON lead request and returns either HTTP 202 or a controlled HTTP 422. It has no external integrations and can be tested with invented data immediately after import.",
        "height": 260,
        "width": 420
      },
