        -900,
        0
      ],
      "webhookId": "0e296f5d-d5af-4c79-8d35-c75f8f4608f3"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst headers = $json.headers ?? {};\nconst clean = (value, max = 200) => typeof value === 'string' ? value.trim().slice(0, max) : '';\nconst requestId = clean(input.request_id ?? headers['x-request-id'], 100);\nconst email = clean(input.email, 254).toLowerCase();\nconst consentValue = input.consent;\nconst consent = consentValue === true || ['true', 'yes', '1'].includes(String(consentValue).toLowerCase());\nconst companyDomain = clean(input.company_domain, 253).toLowerCase().replace(/^https?:\\/\\//, '').replace(/\\/.*$/, '');\nconst errors = [];\nif (!requestId) errors.push({ field: 'request_id', message: 'request_id is required' });\nif (!email) errors.push({ field: 'email', message: 'email is required' });\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push({ field: 'email', message: 'email format is invalid' });\nif (consentValue === undefined || consentValue === null || consentValue === '') errors.push({ field: 'consent', message: 'consent is required' });\nconst lead = {\n  request_id: requestId,\n  email,\n  first_name: clean(input.first_name, 100),\n  last_name: clean(input.last_name, 100),\n  company: clean(input.company, 160),\n  company_domain: companyDomain,\n  job_title: clean(input.job_title, 160),\n  company_size: clean(input.company_size, 40),\n  message: clean(input.message, 2000),\n  consent\n};\nreturn [{ json: { valid: errors.length === 0, validation_errors: errors, lead } }];"
      },
