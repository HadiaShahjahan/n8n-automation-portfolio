        "path": "portfolio-lead-validation",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "dcd5b958-6a03-4e45-b842-73e06088e510",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
